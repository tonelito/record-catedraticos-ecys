# Copiar este archivo como .env y completar con la URL real del backend.
# .env nunca se sube a git (ver .gitignore) — este archivo sí, para que
# cualquiera que clone el repo sepa qué variable necesita configurar.
#
# Vite solo expone al navegador las variables que empiezan con VITE_ —
# cualquier otro nombre queda oculto del código del cliente a propósito.
VITE_API_URL="https://record-catedraticos-ecys.onrender.com"
