# Copiar este archivo como .env y completar con valores reales.
# .env nunca se sube a git (ver .gitignore) — este archivo sí, para que
# cualquiera que clone el repo sepa qué variables necesita configurar.

# Cadena de conexión de Postgres (Neon). Usar la conexión directa, no la
# _POOLED — este backend abre un solo pg.Pool al arrancar y lo reutiliza,
# no necesita pasar por el connection pooler de Neon.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Secreto usado para firmar los JWT de sesión. No reusar el de otro proyecto.
JWT_SECRET="reemplazar-por-un-valor-largo-y-aleatorio"

# Puerto donde escucha el servidor Express en desarrollo local.
# Render asigna su propio puerto en producción vía esta misma variable.
PORT=3000

# Orígenes permitidos por CORS: uno o varios separados por coma (la URL de
# Vite en local, la del frontend en Vercel). Cualquier *.vercel.app se acepta
# igual, para que también funcionen las URLs de preview de cada despliegue.
CORS_ORIGIN="http://localhost:5173,https://tu-proyecto.vercel.app"
